    "Rings full-screen even when the app is closed and breaks through silent mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzwoni na pełnym ekranie nawet przy zamkniętej aplikacji i przebija tryb cichy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt im Vollbild, auch wenn die App geschlossen ist — und durchbricht den Lautlos-Modus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a pantalla completa incluso con la app cerrada y atraviesa el modo silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne en plein écran même app fermée et passe outre le mode silencieux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em tela cheia mesmo com o app fechado e ignora o modo silencioso."
          }
