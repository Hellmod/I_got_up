    "After dismissing the alarm, a confirmation request arrives after %lld min. No response for %lld min — the alarm rings again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إيقاف المنبه، يصلك طلب تأكيد بعد %lld د. بدون رد لمدة %lld د، يرن المنبه مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Ausschalten des Weckers erhältst du nach %lld Min. eine Bestätigungsanfrage. Keine Antwort für %lld Min. — der Wecker klingelt erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras apagar la alarma, recibirás una solicitud de confirmación después de %lld min. Sin respuesta durante %lld min, la alarma vuelve a sonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l'arrêt de l'alarme, une demande de confirmation arrive au bout de %lld min. Sans réponse pendant %lld min, l'alarme sonne à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म बंद करने के बाद %lld मिनट में पुष्टि का अनुरोध आएगा। %lld मिनट तक जवाब न मिलने पर अलार्म फिर बजेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラームを止めると、%lld分後に確認通知が届きます。%lld分間応答がないと再び鳴ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyłączeniu alarmu, po %lld min otrzymasz prośbę o potwierdzenie. Brak odpowiedzi przez %lld min — alarm zadzwoni ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após desligar o alarme, você recebe um pedido de confirmação em %lld min. Sem resposta por %lld min, o alarme toca de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После выключения будильника через %lld мин придёт запрос подтверждения. Нет ответа %lld мин — будильник зазвонит снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭闹钟后，%lld 分钟后会收到确认请求。%lld 分钟内无响应，闹钟将再次响起。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver spento la sveglia, una richiesta di conferma arriva dopo %lld min. Nessuna risposta per %lld min — la sveglia suona di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat je het alarm hebt uitgezet, verschijnt na %lld min een bevestigingsverzoek. Geen reactie binnen %lld min — het alarm gaat opnieuw af."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du stängt av alarmet kommer en bekräftelsebegäran efter %lld min. Inget svar på %lld min — alarmet ringer igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmı kapattıktan sonra %lld dk sonra bir onay isteği gelir. %lld dk yanıt yok — alarm tekrar çalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після вимкнення будильника через %lld хв надійде запит на підтвердження. Немає відповіді %lld хв — будильник дзвонить знову."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah mematikan alarm, permintaan konfirmasi muncul setelah %lld mnt. Tidak ada respons selama %lld mnt — alarm berbunyi lagi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알람을 끈 뒤 %lld분 후에 확인 요청이 옵니다. %lld분 동안 응답이 없으면 알람이 다시 울립니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi tắt báo thức, yêu cầu xác nhận xuất hiện sau %lld phút. Không phản hồi trong %lld phút — báo thức reo lại."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังจากปิดนาฬิกาปลุก คำขอยืนยันจะมาถึงหลัง %lld นาที ไม่ตอบกลับภายใน %lld นาที — นาฬิกาปลุกจะดังอีกครั้ง"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉鬧鐘後，%lld 分鐘後會出現確認要求。%lld 分鐘沒有回應 — 鬧鐘會再次響起。"
          }
        }
      }
    },
