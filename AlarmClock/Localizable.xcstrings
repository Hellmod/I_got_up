    "When disabled, new alarm events won't be saved to history." : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyłączeniu nowe zdarzenia budzika nie będą zapisywane w historii."
