    "Confirm you're awake — otherwise the alarm will ring again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد أنك مستيقظ — وإلا سيرن المنبه مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige, dass du wach bist — sonst klingelt der Wecker erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma que estás despierto; si no, la alarma volverá a sonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez que vous êtes réveillé, sinon l'alarme sonnera à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुष्टि करें कि आप जाग रहे हैं — वरना अलार्म फिर बजेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起きていることを確認してください。しないとアラームが再び鳴ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdź, że nie śpisz — inaczej alarm zadzwoni ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme que você está acordado — senão o alarme tocará de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверди, что не спишь, — иначе будильник зазвонит снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认你已醒来，否则闹钟将再次响起。"
